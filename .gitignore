# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/test-results/
/playwright-report/

# The attorney review pack: screenshots and a ~15MB Word file, all of it
# regenerable from scripts/review-doc. The scripts are tracked; their output
# is not.
/review-pack/

# Audit binaries: ~27MB of screenshots and generated PDFs, reproducible from
# audit/tools. The analyses, the tools, and the textual captures ARE tracked —
# they are the evidence a finding is cited against.
/audit/evidence/screenshots/
/audit/evidence/pdfs/
/audit/evidence/og-options/

